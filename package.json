{
  "name": "notomed-whats",
  "version": "0.1.0",
  "description": "Sistema de emissão de NFS-e para médicos via WhatsApp",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "node --import tsx src/server.ts",
    "migrate:agente": "node scripts/migrar-investigacoes-emissao.mjs",
    "migrate:preparacao": "node scripts/migrar-preparacao-fiscal.mjs",
    "migrate:comparacao": "node scripts/migrar-comparacao-fiscal.mjs",
    "migrate:perfil": "node scripts/migrar-dados-profissionais.mjs",
    "consultar:registro": "node --import tsx scripts/consultar-registro-profissional.mjs",
    "migrate:conversa": "node scripts/migrar-conversa-mensagens.mjs",
    "migrate:cadastro": "node scripts/migrar-cadastro-certificado.mjs",
    "retry:nota": "node scripts/reprocessar-nota.mjs",
    "test": "tsc --noEmit -p tsconfig.test.json && vitest run",
    "test:tribemd-browser": "tsc --noEmit -p tsconfig.test.json && TRIBEMD_BROWSER_REQUIRED=1 vitest run tests/tribemd-sync-janela.test.ts",
    "migrate:operador": "node scripts/migrar-operador-foco.mjs",
    "operador:vincular-secretaria": "node scripts/vincular-secretaria.mjs",
    "migrate:conversa-continua": "node scripts/migrar-conversa-continua.mjs",
    "migrate:uso-mensal-seguranca": "node scripts/migrar-uso-mensal-medico-seguranca.mjs",
    "migrate:medicos-conta": "node scripts/migrar-medicos-por-conta.mjs",
    "migrate:compat-conta": "node scripts/migrar-compatibilidade-conta.mjs",
    "migrate:profissional-externo": "node scripts/migrar-profissional-externo-id.mjs"
  },
  "keywords": [
    "nfse",
    "whatsapp",
    "medicos",
    "saas"
  ],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.0",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@nfewizard/types": "^1.0.11",
    "@supabase/supabase-js": "^2.117.2",
    "compression": "^1.8.2",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.0",
    "playwright-core": "1.63.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "xml-crypto": "^6.3.2",
    "zod": "^3.24.0"
  },
  "overrides": {
    "vite": "6.4.4"
  }
}
