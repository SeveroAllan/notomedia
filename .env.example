# Noto — um app: painel, cadastro, WhatsApp, API fiscal e worker embutido.
# Preencher segredos no ambiente do serviço; não comitar valores reais.
# Segredos ficam vazios; gere valores próprios e configure no Easypanel.

# Servidor único
PORT=3000
HOST=0.0.0.0

# Supabase, banco e criptografia
DATABASE_URL=
SUPABASE_URL=https://supabase.seudominio.com
SUPABASE_SERVICE_ROLE_KEY=
ENCRYPTION_KEY=
APP_PEPPER=

# Evolution: Noto Oficial (OTP) e WhatsApp dos usuários
EVOLUTION_API_URL=https://evolution.seudominio.com
EVOLUTION_GLOBAL_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_OFFICIAL_INSTANCE_NAME=notomed_oficial

# Evolution para avisos de falha fiscal ao médico
EVOLUTION_ASSISTANT_URL=https://evolution-assistente.seudominio.com
EVOLUTION_ASSISTANT_API_KEY=
EVOLUTION_ASSISTANT_INSTANCE_NAME=notomed_assistente
EVOLUTION_ASSISTANT_WEBHOOK_SECRET=

# Pesquisa cadastral: OpenSerp e extração de CRM/RQE
NVIDIA_API_KEY=
NVIDIA_REGISTRO_MODEL=meta/llama-3.2-90b-vision-instruct
OPENSERP_BASE_URL=
HUB_DESENVOLVEDOR_TOKEN=

# Emissão e PDF: preservar os valores atuais das proteções fiscais
AGENTE_FISCAL_ATIVO=false
PREPARACAO_FISCAL_ATIVA=false
# Emissão automática por comprovante: apenas homologação.
EMISSAO_COMPROVANTE_HOMOLOGACAO_ATIVA=false
# Ligar somente após revisão dos modelos e usando telefones de teste.
ENVIO_MEDICO_REAL_ATIVO=false
ENVIO_PACIENTE_REAL_ATIVO=false
ENVIO_REAL_ALLOWLIST=
MEU_DANFE_API_KEY=

# Alertas opcionais
RESEND_API_KEY=
DEV_EMAIL_ALERTA=dev@seudominio.com

# Cofre dos usuários no painel
# Use a mesma origem, chave e volume já utilizados em instalações existentes.
# A compatibilidade com os aliases legados permanece no cofre.
COFRE_ORIGEM=https://seu-dominio
COFRE_CHAVE=
COFRE_DIRETORIO=/dados/tribemd

# A chave do cofre precisa ser estável, conter 32 bytes em base64 e ficar fora do Git.
# Perfis de usuários ficam em <diretorio>/cofres-contas-v1.
# Manter volume persistente e uma única réplica do aplicativo para os cofres.
# O cofre do painel usa a sessão Supabase do usuário.
# CHROMIUM_EXECUTABLE_PATH e XVFB_EXECUTABLE_PATH são opcionais; a imagem já inclui ambos.
# AGENTE_FISCAL_ATIVO controla proteções da fila/emissor; os agentes antigos foram removidos.
