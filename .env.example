# Noto — um app: painel, cadastro, WhatsApp, API fiscal e worker embutido.
# Preencher segredos no ambiente do serviço; não comitar valores reais.
# Segredos ficam vazios; gere valores próprios e configure no Easypanel.

# Servidor único
PORT=3000
HOST=0.0.0.0

# Supabase, banco e criptografia
DATABASE_URL=
SUPABASE_URL=https://supabase.seudominio.com
SUPABASE_SERVICE_ROLE_KEY=
ENCRYPTION_KEY=
APP_PEPPER=

# Evolution: Noto Oficial (OTP) e WhatsApp dos usuários
EVOLUTION_API_URL=https://evolution.seudominio.com
EVOLUTION_GLOBAL_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_OFFICIAL_INSTANCE_NAME=notomed_oficial

# Evolution para avisos de falha fiscal ao médico
EVOLUTION_ASSISTANT_URL=https://evolution-assistente.seudominio.com
EVOLUTION_ASSISTANT_API_KEY=
EVOLUTION_ASSISTANT_INSTANCE_NAME=notomed_assistente
EVOLUTION_ASSISTANT_WEBHOOK_SECRET=

# Pesquisa cadastral: OpenSerp e extração de CRM/RQE
NVIDIA_API_KEY=
NVIDIA_REGISTRO_MODEL=meta/llama-3.2-90b-vision-instruct
OPENSERP_BASE_URL=
HUB_DESENVOLVEDOR_TOKEN=

# Agente Noto — primeira entrega SOMENTE leitura de estado das agendas.
# Ambos desligados por padrão; o envio exige ENVIO_REAL_ALLOWLIST e o webhook secreto da instância assistente.
# Configure na Evolution o webhook MESSAGES_UPSERT do assistente em /webhook/evolution,
# com o cabeçalho x-webhook-secret igual a EVOLUTION_ASSISTANT_WEBHOOK_SECRET.
# Noto Assistente: teste só em ambiente separado e com allowlist explícita.
# Requer OPENAI_API_KEY e EVOLUTION_ASSISTANT_WEBHOOK_SECRET.
OPENAI_API_KEY=
OPENAI_TEXTO_MODEL=gpt-4o-mini
NOTO_AGENT_ATIVO=false
NOTO_AGENT_ENVIO_ATIVO=false
# Fila duravel do agente: somente apos migracao autorizada e rodada IA ativa
NOTO_AGENT_TRABALHOS_ATIVO=false
# Retomada do agente por eventos concluídos; opt-in e bloqueio por allowlist/orcamento
NOTO_AGENT_CONTINUIDADE_EVENTOS_ATIVA=false
# SDK Agents: permite traces sem conteúdo sensível apenas quando habilitado.
NOTO_AGENT_TRACES_ATIVOS=false
# Registrar somente códigos, latências, totais de tokens e HMAC da mensagem do teste.
NOTO_AGENT_DIAGNOSTICO_ATIVO=false
# Worker completo: false não constrói/requisita fila de notas (produçao mantém true por omissão).
NOTO_WORKER_EMBUTIDO_ATIVO=true
# SOMENTE processo start:piloto-agente, nunca usar DATABASE_URL/service-role do app principal.
NOTO_AGENT_PILOTO_DATABASE_URL=
# No aplicativo normal e apenas para o número da allowlist após OTP validado:
# nunca criar automaticamente uma segunda conta para o piloto.
NOTO_AGENT_LOGIN_CONTA_EXISTENTE_APENAS=false
NOTO_AGENT_BOAS_VINDAS_OTP_TESTE_ATIVAS=false

# Emissão e PDF: preservar os valores atuais das proteções fiscais
AGENTE_FISCAL_ATIVO=false
PREPARACAO_FISCAL_ATIVA=false
# Emissão automática por comprovante: apenas homologação.
EMISSAO_COMPROVANTE_HOMOLOGACAO_ATIVA=false
# Ligar somente após revisão dos modelos e usando telefones de teste.
ENVIO_MEDICO_REAL_ATIVO=false
ENVIO_PACIENTE_REAL_ATIVO=false
ENVIO_REAL_ALLOWLIST=
MEU_DANFE_API_KEY=

# Alertas opcionais
RESEND_API_KEY=
DEV_EMAIL_ALERTA=dev@seudominio.com

# Cofre dos usuários no painel
# HOMOLOGAÇÃO: use volume NOMEADO EXCLUSIVO e uma COFRE_CHAVE NOVA (32 bytes base64).
# NÃO utilizar /dados/tribemd, diretórios do piloto ou aliases TRIBEMD_TESTE_*.
# COFRE_ORIGEM deve ser idêntica a APP_PUBLIC_ORIGIN HTTPS da homologação.
# Segredos apenas no ambiente. Em outros ambientes, aliases legados permanecem.
COFRE_ORIGEM=https://seu-dominio
COFRE_CHAVE=
COFRE_DIRETORIO=/dados/tribemd
# Diretório local onde o operador deposita o código 2FA do Amplimed (recriado a cada boot).
NOTO_AMPLIMED_2FA_DIRETORIO=
# Reconciliação de recusa SEFIN (HEAD /dps/{id}) antes de retomar emissão; inativa por padrão.
RETOMADA_RECUSA_SEFIN_ATIVA=false

# A chave do cofre precisa ser estável, conter 32 bytes em base64 e ficar fora do Git.
# Perfis de usuários ficam em <diretorio>/cofres-contas-v1.
# Manter volume persistente e uma única réplica do aplicativo para os cofres.
# O cofre do painel usa a sessão Supabase do usuário.
# CHROMIUM_EXECUTABLE_PATH e XVFB_EXECUTABLE_PATH são opcionais; a imagem já inclui ambos.
# AGENTE_FISCAL_ATIVO controla proteções da fila/emissor; os agentes antigos foram removidos.

# Canal extra de teste. WhatsApp continua sendo o padrão; nenhuma criação de conta por e-mail.
LOGIN_OTP_EMAIL_ENABLED=false
# Somente severoallan2019@gmail.com pode ser autorizado; ausente/vazia bloqueia todos.
LOGIN_OTP_EMAIL_ALLOWLIST=
# Remetente validado no Resend. Usa RESEND_API_KEY já definido acima.
LOGIN_OTP_EMAIL_FROM=
