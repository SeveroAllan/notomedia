# Serviço da homologação: navegador real + modo restrito obrigatório.
FROM node:22-alpine
WORKDIR /app
RUN apk add --no-cache chromium xvfb nss freetype harfbuzz ca-certificates ttf-freefont
COPY package*.json ./
RUN npm ci --omit=dev
COPY tsconfig.json ./
COPY agent.md ./agent.md
COPY onboarding-noto.md ./onboarding-noto.md
COPY bloco-ferramentas.md ./bloco-ferramentas.md
COPY contrato-continuar-onboarding.md ./contrato-continuar-onboarding.md
COPY .agents/skills/noto-acesso-agendas/SKILL.md ./.agents/skills/noto-acesso-agendas/SKILL.md
COPY src ./src
COPY scripts ./scripts
ENV NODE_ENV=production PORT=3000 \
    CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser \
    XVFB_EXECUTABLE_PATH=/usr/bin/Xvfb
EXPOSE 3000
# Sem VOLUME anônimo: montagem nomeada persistente é obrigatória no orquestrador.
CMD ["npm", "run", "start:homologacao"]
